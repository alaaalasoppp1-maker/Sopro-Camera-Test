<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/soft_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sopro Camera Test v0.2"
            android:textStyle="bold"
            android:textSize="23sp"
            android:textColor="@color/text"/>

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Waiting..."
            android:textSize="15sp"
            android:textColor="@color/muted"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Step 1 — Connect"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONNECT CAMERA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Step 2 — Read-only EM28xx probe"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text"/>

        <Button
            android:id="@+id/btnProbe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="PROBE EM28XX REGISTERS"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Step 3 — Data tests"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text"/>

        <Button
            android:id="@+id/btnBulk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TEST BULK 0x84 (3 SEC)"/>

        <Button
            android:id="@+id/btnButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TEST PHYSICAL BUTTON (10 SEC)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:text="v0.2 does not write camera registers.\nIt reads chip state and checks whether data/button events are already available."
            android:textSize="13sp"
            android:textColor="@color/muted"/>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="REFRESH USB"/>
    </LinearLayout>

    <Space
        android:layout_width="12dp"
        android:layout_height="1dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnostics"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text"/>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="COPY LOG"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="SAVE LOG"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
