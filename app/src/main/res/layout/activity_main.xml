<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/soft_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.65"
            android:background="#07111E">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Camera preview"/>

            <TextView
                android:id="@+id/previewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:padding="8dp"
                android:background="#99000000"
                android:text="Camera idle"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:padding="8dp"
                android:background="#99000000"
                android:text="0 fps"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </FrameLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp"/>

        <ScrollView
            android:id="@+id/controlScroll"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fadeScrollbars="false"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical"
            android:overScrollMode="always">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sopro Camera Player"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/text"/>

            <TextView
                android:id="@+id/deviceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="VID EB1A : PID 2821"
                android:textSize="12sp"
                android:textColor="@color/muted"/>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="CONNECT"/>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="START CAMERA"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="STOP"/>

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="CAPTURE"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SAVE IMAGE"/>

            <Button
                android:id="@+id/btnColor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="COLOR MODE: AUTO"/>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/profileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profile: not initialized"
                android:textSize="12sp"
                android:textColor="@color/muted"/>

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="COPY LOG"/>
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="10sp"
            android:textColor="@color/text"/>
    </ScrollView>
</LinearLayout>
