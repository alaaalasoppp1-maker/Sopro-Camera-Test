<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/soft_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.05"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sopro Camera — One Shot Diagnostics"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/text"/>

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Waiting..."
            android:textSize="13sp"
            android:textColor="@color/muted"/>

        <Button
            android:id="@+id/btnRunAll"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:text="RUN ALL TESTS"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/runHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="At the final button test, press the physical camera button several times."
            android:textSize="12sp"
            android:textColor="@color/muted"/>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"/>

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ready"
            android:textSize="12sp"
            android:textColor="@color/muted"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Individual tests"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text"/>

        <ScrollView
            android:id="@+id/controlScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:fadeScrollbars="false"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CONNECT / RECONNECT"/>

                <Button
                    android:id="@+id/btnDescriptor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="RAW DESCRIPTORS"/>

                <Button
                    android:id="@+id/btnProbe"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="EM28XX REGISTER DUMP"/>

                <Button
                    android:id="@+id/btnI2cCommon"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="COMMON I2C PROBE"/>

                <Button
                    android:id="@+id/btnI2cFull"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="FULL I2C SCAN"/>

                <Button
                    android:id="@+id/btnAlt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="VIDEO ALT SETTINGS TEST"/>

                <Button
                    android:id="@+id/btnBulk"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="BULK 0x84 TEST"/>

                <Button
                    android:id="@+id/btnButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="PHYSICAL BUTTON TEST"/>

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="REFRESH USB"/>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <Space
        android:layout_width="10dp"
        android:layout_height="1dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.35"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnostics Log"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/text"/>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="COPY LOG"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="SAVE LOG"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
